{
  "build": {
    "env": {
      "CI": "false"
    }
  },
  "headers": [
    {
      "source": "/photos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "routes": [
    { "src": "/[^.]+", "dest": "/", "status": 200 }
  ]
}
